{%- comment -%}
  Drawer du comparateur (Partie A.2)

  Conteneur global rendu une seule fois dans theme.liquid. La structure
  (lanceur flottant + panneau latéral) est statique ; le contenu (cartes
  produit) est injecté par comparator.js à partir des données Storefront API.
  Tout est masqué tant qu'aucun produit n'est sélectionné.
{%- endcomment -%}

{{ 'component-comparator-drawer.css' | asset_url | stylesheet_tag }}

<div class="comparator" data-comparator>
  {%- comment -%} Lanceur flottant : révélé par le JS dès qu'un produit est ajouté {%- endcomment -%}
  <button
    type="button"
    class="comparator-launcher"
    data-comparator-open
    aria-haspopup="dialog"
    aria-controls="comparator-drawer"
    hidden
  >
    <span class="comparator-launcher__icon" aria-hidden="true">
      <svg viewBox="0 0 18 18" width="20" height="20" fill="none">
        <path d="M6.5 3.5 3 7l3.5 3.5M11.5 7.5 15 11l-3.5 3.5M3 7h9M6 11h9"
          stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
    <span class="comparator-launcher__label">{{ 'comparator.label' | t }}</span>
    <span class="comparator-launcher__count" data-comparator-count>0</span>
  </button>

  <div class="comparator-overlay" data-comparator-overlay hidden></div>

  <aside
    id="comparator-drawer"
    class="comparator-drawer"
    role="dialog"
    aria-modal="true"
    aria-labelledby="comparator-drawer-title"
    aria-hidden="true"
    hidden
  >
    <header class="comparator-drawer__header">
      <h2 id="comparator-drawer-title" class="comparator-drawer__title">
        {{ 'comparator.heading' | t }} <span class="comparator-drawer__count"><span data-comparator-count>0</span>/4</span>
      </h2>
      <button type="button" class="comparator-drawer__close" data-comparator-close aria-label="{{ 'comparator.close' | t }}">
        <svg viewBox="0 0 18 18" width="18" height="18" fill="none" aria-hidden="true">
          <path d="M4 4l10 10M14 4 4 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
    </header>

    {%- comment -%} Corps : états (liste / vide / chargement / erreur) rendus par comparator.js {%- endcomment -%}
    <div class="comparator-drawer__body" data-comparator-body aria-live="polite"></div>

    {%- comment -%}
      CTA « Comparer » : route vers la page de comparaison choisie dans les
      réglages du thème (Comparateur → Page de comparaison). Tant qu'aucune page
      n'est assignée, le lien reste désactivé (aria-disabled) plutôt que de
      renvoyer vers une URL morte.
    {%- endcomment -%}
    {%- assign compare_page = pages[settings.comparator_page] -%}
    <footer class="comparator-drawer__footer">
      <button type="button" class="comparator-drawer__clear" data-comparator-clear>{{ 'comparator.clear' | t }}</button>
      {%- if compare_page != blank -%}
        <a
          class="comparator-drawer__cta button"
          data-comparator-compare
          href="{{ compare_page.url }}"
          role="button"
        >{{ 'comparator.label' | t }}</a>
      {%- else -%}
        <a
          class="comparator-drawer__cta button"
          data-comparator-compare
          href="#"
          role="button"
          aria-disabled="true"
        >{{ 'comparator.label' | t }}</a>
      {%- endif -%}
    </footer>
  </aside>
</div>
