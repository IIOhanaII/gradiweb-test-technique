{%- comment -%}
  Barre de comparaison persistante (Partie A.2)

  Bandeau flottant en bas de page, rendu une seule fois dans theme.liquid.
  - Visible dès qu'un produit est ajouté, masqué quand la liste est vide (JS).
  - Affiche les produits sélectionnés (miniature, titre, prix, retrait individuel)
    — données récupérées via Storefront API, jamais en Liquid.
  - Mobile : barre compacte, dépliée vers le haut via le bouton chevron.
    À partir de 750px : la vue enrichie est affichée directement.
  - CTA « Comparer maintenant » → page de comparaison (réglage de thème).
    Tant qu'aucune page n'est assignée, le lien reste désactivé (aria-disabled).
{%- endcomment -%}

{{ 'component-comparator-drawer.css' | asset_url | stylesheet_tag }}

{%- assign compare_page = pages[settings.comparator_page] -%}

<div class="comparator" data-comparator>
  <section
    class="comparator-bar"
    data-comparator-bar
    aria-label="{{ 'comparator.heading' | t }}"
    hidden
  >
    {%- comment -%} Corps : cartes produit injectées par comparator.js (DOM, pas innerHTML). {%- endcomment -%}
    <div class="comparator-bar__body" id="comparator-bar-body" data-comparator-body aria-live="polite"></div>

    <div class="comparator-bar__controls">
      <button
        type="button"
        class="comparator-bar__toggle"
        data-comparator-toggle
        aria-expanded="false"
        aria-controls="comparator-bar-body"
      >
        <span class="comparator-bar__heading">{{ 'comparator.heading' | t }}</span>
        <span class="comparator-bar__count"><span data-comparator-count>0</span>/4</span>
        <span class="comparator-bar__chevron" aria-hidden="true">
          <svg viewBox="0 0 18 18" width="14" height="14" fill="none">
            <path d="M4 11l5-5 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </button>

      <button type="button" class="comparator-bar__clear" data-comparator-clear>{{ 'comparator.clear' | t }}</button>

      {%- if compare_page != blank -%}
        <a
          class="comparator-bar__cta button"
          data-comparator-compare
          href="{{ compare_page.url }}"
          role="button"
        >{{ 'comparator.compare_now' | t }}</a>
      {%- else -%}
        <a
          class="comparator-bar__cta button"
          data-comparator-compare
          href="#"
          role="button"
          aria-disabled="true"
        >{{ 'comparator.compare_now' | t }}</a>
      {%- endif -%}
    </div>
  </section>
</div>
