{%- comment -%}
  Bouton « Ajouter à la comparaison » (Partie A.1)

  Rendu soit comme block de la section `main-product` (when 'compare_button'),
  soit directement : {% render 'compare-button', product: product %}

  Ne stocke côté client que l'identité du produit (id + handle). Les libellés
  des différents états sont passés en data-attributes pour que comparator.js
  pilote l'affichage sans chaîne en dur dans le JS.

  Paramètres :
    - product (obligatoire) : l'objet produit à comparer
    - block    (optionnel)  : pour les attributs de l'éditeur de thème
{%- endcomment -%}

{%- if product != blank -%}
  {{ 'component-compare-button.css' | asset_url | stylesheet_tag }}

  <div class="compare-button-wrapper" {{ block.shopify_attributes }}>
    <button
      type="button"
      class="compare-button button button--secondary"
      data-compare-button
      data-compare-id="{{ product.id }}"
      data-compare-handle="{{ product.handle }}"
      data-label-add="Ajouter à la comparaison"
      data-label-added="Ajouté à la comparaison"
      data-label-full="Maximum 4 produits — retirez-en un pour comparer celui-ci"
      aria-pressed="false"
    >
      <span class="compare-button__icon" aria-hidden="true">
        <svg viewBox="0 0 18 18" fill="none" width="18" height="18">
          <path
            d="M6.5 3.5 3 7l3.5 3.5M11.5 7.5 15 11l-3.5 3.5M3 7h9M6 11h9"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>
      <span class="compare-button__label" data-compare-label>Ajouter à la comparaison</span>
    </button>
    <span class="compare-button__hint" data-compare-hint role="status" hidden></span>
  </div>
{%- endif -%}
